{
  "id": "org.umrk.syncthing",
  "service": {
    "schema": 1,
    "id": "org.umrk.syncthing",
    "run": {
      "path": "bin/leaf-syncthing",
      "args": [
        "service",
        "run"
      ]
    },
    "restart": "on-failure",
    "default_enabled": false,
    "stop_grace_ms": 10000,
    "lifecycle": {
      "game": "notify",
      "stop_on_storage_change": true,
      "stop_on_suspend": true
    }
  },
  "state": {
    "root": "Syncthing",
    "revoke_on_uninstall": [
      "leaf/trusted-clients.json"
    ],
    "retained_roots": [
      "root-0",
      "root-1",
      "root-2",
      "root-3",
      "root-4",
      "root-5",
      "root-6",
      "root-7",
      "root-8",
      "root-9",
      "root-10",
      "root-11",
      "root-12",
      "root-13",
      "root-14",
      "root-15",
      "root-16"
    ]
  }
}
