#: internal/retroarch/shader_strings.c
msgid "Adds a Pocket-style backing texture and low-cost pixel grid tuned for Game Boy Color art."
msgstr "Mô phỏng lớp nền phong cách máy Pocket và lưới điểm ảnh nhẹ tối ưu cho đồ họa Game Boy Color."

#: internal/retroarch/shader_strings.c
msgid "Adds a gray backing texture, low-cost pixel grid, and transparency response tuned for the original GBA screen."
msgstr "Thêm nền xám, lưới điểm ảnh nhẹ và độ tương phản xuyên sáng tối ưu theo màn hình GBA gốc."

#: internal/retroarch/shader_strings.c
msgid "Adds a lightweight aperture mask and softened scanlines without curvature."
msgstr "Tạo hiệu ứng mặt nạ tia (aperture mask) nhẹ và đường quét mềm mại trên màn phẳng."

#: internal/retroarch/shader_strings.c
msgid "Adds a subdued Pocket-style backing texture, pixel grid, and edge shadows for original Game Boy games."
msgstr "Mô phỏng lớp nền trầm kiểu Pocket, lưới điểm ảnh và đổ bóng viền cho game Game Boy cổ điển."

#: internal/retroarch/shader_strings.c
msgid "Adds lightweight scanlines with reduced darkness for 8-bit, 16-bit, and PlayStation-era games."
msgstr "Tạo đường quét nhẹ nhàng giảm độ tối, thích hợp cho game thế hệ 8-bit, 16-bit và PlayStation."

#: internal/retroarch/shader_strings.c
msgid "Adds the fine RGB pixel grid of a handheld LCD panel."
msgstr "Mô phỏng lưới điểm ảnh phụ RGB siêu mịn của tấm nền LCD cầm tay."

