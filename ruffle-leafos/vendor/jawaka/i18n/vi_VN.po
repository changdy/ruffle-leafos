#: internal/settings/storage_ui.c
msgid "You can save files again."
msgstr "Bây giờ bạn đã có thể lưu tệp bình thường."

#: internal/settings/storage_ui.c
msgid "Your SD card check did not finish successfully."
msgstr "Quá trình quét thẻ nhớ không thành công."

#: internal/settings/storage_ui.c
msgid "Your SD card is protected"
msgstr "Thẻ SD đang được bảo vệ chống ghi"

#: internal/settings/storage_ui.c
msgid "Your SD card is protected because your last shutdown didn't finish saving. Restart your device to check it."
msgstr "Thẻ nhớ đang tạm khóa chống ghi do lần tắt máy trước chưa lưu xong. Hãy khởi động lại để máy quét kiểm tra thẻ."

#: cmd/jawaka-osd/game_launch.c
msgid "Your SD card is read-only"
msgstr "Thẻ SD của bạn đang ở chế độ chỉ đọc"

#: internal/settings/storage_ui.c
msgid "Your SD card is read-only after a file system error. You can't save new files or changes to this card. This can happen after an unexpected shutdown."
msgstr "Thẻ SD đã bị khóa chỉ đọc do phát hiện lỗi tệp hệ thống (thường do tắt máy đột ngột). Hiện không thể lưu tệp mới hay sửa dữ liệu."

#: cmd/jawaka-launcher/main.c
msgid "Your SD card is read-only. Nothing new can be saved to it."
msgstr "Thẻ SD đang ở chế độ chỉ đọc. Không thể lưu thêm dữ liệu."

#: internal/settings/storage_ui.c
msgid "Your SD card is read-only. The cause couldn't be determined. You can't save new files or changes to this card."
msgstr "Thẻ SD đang ở chế độ chỉ đọc chưa rõ nguyên nhân. Không thể ghi mới hay chỉnh sửa dữ liệu trên thẻ này."

#: internal/settings/storage_ui.c
msgid "Your SD card is still protected. Turn off your device, repair the card on a computer, safely eject it, then insert it and turn your device on to check it again."
msgstr "Thẻ nhớ vẫn đang bị khóa bảo vệ. Hãy tắt nguồn máy, sửa lỗi thẻ trên máy tính, ngắt thẻ an toàn rồi lắp lại vào máy để kiểm tra lại."

#: cmd/jawaka-launcher/main.c
msgid "Your SD card is waiting for repair. Nothing new can be saved to it."
msgstr "Thẻ SD đang chờ sửa chữa. Không thể ghi dữ liệu mới vào lúc này."

#: internal/settings/storage_ui.c
msgid "Your SD card is write-protected"
msgstr "Thẻ SD đang bị khóa chống ghi"

#: cmd/jawaka-launcher/main.c
msgid "Your SD card isn't available."
msgstr "Thẻ SD hiện không sẵn sàng."

#: internal/settings/storage_ui.c
msgid "Your SD card needs repair"
msgstr "Thẻ SD của bạn cần được sửa lỗi"

#: internal/settings/storage_ui.c
msgid "Your card passed the file system check."
msgstr "Thẻ nhớ đã vượt qua bài kiểm tra hệ thống tệp."

#: internal/settings/storage_ui.c
msgid "Your device can't write to this card, so it can't be repaired here."
msgstr "Máy không có quyền ghi lên thẻ này nên không thể tự sửa lỗi tại đây."

#: internal/settings/storage_ui.c
msgid "Your device can't write to this card. If you use an adapter with a lock switch, check that it isn't set to lock."
msgstr "Máy không thể ghi vào thẻ. Nếu bạn dùng áo thẻ (adapter), hãy kiểm tra gạt khóa chống ghi (Lock) xem có đang bật không."

#: internal/settings/storage_ui.c
msgid "Your device will restart to check and repair this card on battery power. If the battery drops below 30 percent before repair starts, it won't run. Damaged files may be shortened, renamed, or recovered under new names. Back up important files on a computer first."
msgstr "Máy sẽ khởi động lại để kiểm tra và sửa thẻ nhớ bằng nguồn pin (yêu cầu pin trên 30%). Các tệp hỏng có thể bị cắt bớt hoặc đổi tên khi khôi phục. Hãy sao lưu các tệp quan trọng vào máy tính trước."

#: internal/settings/storage_ui.c
msgid "Your device will restart to check and repair this card. Damaged files may be shortened, renamed, or recovered under new names. Back up important files on a computer first if you need to recover them. Keep your device connected to power until the check finishes."
msgstr "Máy sẽ khởi động lại để quét và sửa thẻ nhớ. Các tệp hỏng có thể bị cắt bớt hoặc đổi tên. Hãy sao lưu các tệp quan trọng vào máy tính trước và luôn cắm nguồn sạc cho đến khi hoàn tất."

#: internal/settings/storage_ui.c
msgid "Your device will restart to check this card. If the check passes, you can save files again."
msgstr "Thiết bị sẽ khởi động lại để quét thẻ. Nếu thẻ đạt chuẩn, quyền lưu tệp sẽ được kích hoạt lại."

#: internal/settings/storage_ui.c
msgid "Your device's internal storage can't record the repair. Check the card on a computer instead."
msgstr "Bộ nhớ trong của máy không thể ghi nhật ký sửa lỗi. Hãy kiểm tra thẻ trên máy tính."

#: internal/settings/storage_ui.c
msgid "Your last shutdown didn't finish saving."
msgstr "Lần tắt máy gần nhất chưa hoàn tất tiến trình lưu."

#: internal/settings/storage_ui.c
msgid "Your other SD card is still read-only, so your library can't update yet."
msgstr "Thẻ nhớ còn lại vẫn đang bị khóa chỉ đọc nên chưa thể cập nhật thư viện trò chơi."

#: cmd/jawaka-launcher/main.c
msgid "Your saves and save states may not be kept while this SD card is read-only."
msgstr "Bản lưu trong game và save state có thể bị mất khi thẻ SD đang ở chế độ chỉ đọc."

#: cmd/jawaka-launcher/main.c
msgid "Your saves and save states may not be kept while this SD card is waiting for repair."
msgstr "Bản lưu trong game và save state có thể không lưu được khi thẻ SD đang chờ sửa chữa."

