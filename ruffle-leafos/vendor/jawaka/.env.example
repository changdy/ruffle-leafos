# ScreenScraper.fr developer credentials.
# Copy this file to .env.local and replace the placeholder values, or export
# SCREENSCRAPER_DEV_ID and SCREENSCRAPER_DEV_PASSWORD in your environment.
# Dev builds can omit both values; beta and stable Leaf ZIPs require them.
# Jawaka compiles supplied credentials into the launcher binary for scraping.
# .env.local is git-ignored; never commit real credentials.

SCREENSCRAPER_DEV_ID=placeholder_dev_id
SCREENSCRAPER_DEV_PASSWORD=placeholder_dev_password

# Optional ScreenScraper developer debug password.
SCREENSCRAPER_DEBUG_PASSWORD=
